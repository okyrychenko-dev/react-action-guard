{
  "name": "react-action-guard-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write config prettier.config.mjs package.json \"packages/*/*.{json,mjs,ts}\" && pnpm -r run format",
    "format:check": "prettier --check config prettier.config.mjs package.json \"packages/*/*.{json,mjs,ts}\" && pnpm -r run format:check",
    "test": "pnpm run test:run",
    "test:run": "pnpm run test:config && pnpm -r run test:run",
    "test:coverage": "pnpm -r run test:coverage",
    "test:config": "vitest run config/config.test.ts",
    "check": "pnpm run check:toolkit-version && pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run test:run",
    "check:toolkit-version": "node scripts/check-react-zustand-toolkit-version.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.9",
    "yaml": "2.9.0"
  }
}
