{
  "name": "@okyrychenko-dev/react-action-guard-devtools",
  "version": "0.3.0",
  "type": "module",
  "description": "Developer tools for @okyrychenko-dev/react-action-guard",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "style": "./dist/index.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "devtools",
    "ui-blocking",
    "action-guard",
    "typescript",
    "debugging"
  ],
  "author": "Oleksii Kyrychenko alexey.kirichenko@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okyrychenko-dev/react-action-guard-devtools.git"
  },
  "bugs": {
    "url": "https://github.com/okyrychenko-dev/react-action-guard-devtools/issues"
  },
  "homepage": "https://github.com/okyrychenko-dev/react-action-guard-devtools#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@okyrychenko-dev/react-action-guard": "^1.0.5",
    "react": "^18.0.0 || ^19.0.0",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "@okyrychenko-dev/react-zustand-toolkit": "^0.4.2",
    "clsx": "^2.1.1"
  },
  "overrides": {
    "@okyrychenko-dev/react-zustand-toolkit": "^0.4.2",
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5"
  },
  "devDependencies": {
    "@okyrychenko-dev/react-action-guard": "^1.0.5",
    "@storybook/addon-a11y": "10.2.16",
    "@storybook/addon-docs": "10.2.16",
    "@storybook/react-vite": "10.2.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.5",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.2.16",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "storybook": "10.2.16",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.9",
    "zustand": "^5.0.8"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
