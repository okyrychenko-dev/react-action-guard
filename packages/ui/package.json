{
  "name": "@okyrychenko-dev/react-action-guard-ui",
  "version": "0.1.5",
  "type": "module",
  "description": "UI-agnostic guarded control primitives for react-action-guard",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:run && pnpm run build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "react",
    "ui-blocking",
    "accessibility",
    "hooks",
    "guarded-controls",
    "typescript"
  ],
  "author": "Oleksii Kyrychenko alexey.kirichenko@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okyrychenko-dev/react-action-guard.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/okyrychenko-dev/react-action-guard/issues"
  },
  "homepage": "https://github.com/okyrychenko-dev/react-action-guard/tree/main/packages/ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@okyrychenko-dev/react-action-guard": "^1.0.4",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@okyrychenko-dev/react-action-guard": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.9",
    "zustand": "^5.0.8"
  },
  "allowScripts": {
    "esbuild": true
  }
}
