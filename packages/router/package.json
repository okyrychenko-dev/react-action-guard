{
  "name": "@okyrychenko-dev/react-action-guard-router",
  "version": "1.0.0",
  "type": "module",
  "description": "Navigation blocking adapters for React Action Guard across React Router, TanStack Router, and Next.js",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "import": "./dist/react-router/index.js",
      "require": "./dist/react-router/index.cjs"
    },
    "./tanstack-router": {
      "types": "./dist/tanstack-router/index.d.ts",
      "import": "./dist/tanstack-router/index.js",
      "require": "./dist/tanstack-router/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "import": "./dist/nextjs/index.js",
      "require": "./dist/nextjs/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "react",
    "router",
    "navigation",
    "ui-blocking",
    "react-router",
    "tanstack-router",
    "nextjs",
    "navigation-blocking",
    "route-guard",
    "unsaved-changes"
  ],
  "author": "Oleksii Kyrychenko alexey.kirichenko@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okyrychenko-dev/react-action-guard.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/okyrychenko-dev/react-action-guard/issues"
  },
  "homepage": "https://github.com/okyrychenko-dev/react-action-guard/tree/main/packages/router#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@okyrychenko-dev/react-action-guard": "^1.1.0",
    "@tanstack/react-router": "^1.0.0",
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@okyrychenko-dev/react-action-guard": "workspace:*",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tanstack/react-router": "^1.94.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "clsx": "^2.1.1",
    "eslint-plugin-storybook": "^10.3.6",
    "next": "^15.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "7.14.2",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "zustand": "^5.0.8"
  },
  "allowScripts": {
    "esbuild@0.27.2": true,
    "sharp@0.34.5": true
  },
  "dependencies": {
    "@okyrychenko-dev/type-utils": "^0.1.2"
  }
}
