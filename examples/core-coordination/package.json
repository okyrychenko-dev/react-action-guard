{
  "name": "react-action-guard-core-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm --filter @okyrychenko-dev/react-action-guard run build && tsc --noEmit",
    "lint": "eslint src",
    "test:run": "pnpm --filter @okyrychenko-dev/react-action-guard run build && vitest run",
    "test:coverage": "pnpm --filter @okyrychenko-dev/react-action-guard run build && vitest run --coverage",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@okyrychenko-dev/react-action-guard": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "vite": "8.2.1"
  }
}
