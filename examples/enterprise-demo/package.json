{
  "name": "react-action-guard-enterprise-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise checkout/admin demo template for @okyrychenko-dev/react-action-guard",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:local": "node scripts/setup-local.mjs",
    "test:browser": "playwright test",
    "test:imports": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "@okyrychenko-dev/react-action-guard": "^1.0.4",
    "@okyrychenko-dev/react-action-guard-router": "0.2.4",
    "@okyrychenko-dev/react-action-guard-tanstack": "0.3.5",
    "@okyrychenko-dev/react-action-guard-ui": "^0.1.4",
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-react": "^5.2.0",
    "immer": "^10.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.4",
    "vite": "^7.3.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.10",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.9"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
