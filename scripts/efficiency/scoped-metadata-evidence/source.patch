+    expect(previous).toHaveLength(1);
+    expect(previous[0]?.reason).toBe("Saving");
+
+    act(() => addBlocker("sync", { scope: "inventory" }));
+    act(() => updateBlocker("sync", { reason: "Syncing" }));
